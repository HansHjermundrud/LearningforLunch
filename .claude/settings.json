{
  "model": "opus",
  "env": {
    "PYTHONIOENCODING": "utf-8",
    "PYTHONUTF8": "1"
  },
  "bashEditDiffEnabled": false,
  "tui": "fullscreen",
  "viewMode": "focus",
  "permissions": {
    "allow": [
      "Bash(python scripts/*)",
      "Bash(python \"$CLAUDE_PROJECT_DIR\"/scripts/*)",
      "Bash(python3 scripts/*)",
      "Bash(python3 \"$CLAUDE_PROJECT_DIR\"/scripts/*)",
      "Bash(bash exercises/*)",
      "Bash(bash scripts/*)",
      "Bash(python -m unittest *)",
      "Bash(python3 -m unittest *)",
      "Bash(node --test *)",
      "Read",
      "Edit(notes/**)",
      "Edit(state/**)",
      "Edit(exercises/**)",
      "Edit(.viz-scratch/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/sjoen/Desktop/Learning-main/scripts/hook_session_start.py\"",
            "timeout": 20,
            "statusMessage": "Loading lesson state"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/sjoen/Desktop/Learning-main/scripts/session_log.py\"",
            "timeout": 30,
            "statusMessage": "Mirroring lesson to the note"
          },
          {
            "type": "command",
            "command": "python \"C:/Users/sjoen/Desktop/Learning-main/scripts/hook_stop_checkpoint.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/sjoen/Desktop/Learning-main/scripts/hook_precompact.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
